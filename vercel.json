{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/assets/bhavanika.jpg",
      "destination": "/assets/IMG_20260818_203948.jpg?loader=v2",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</assets/gift-page-overrides.css>; rel=stylesheet"
        }
      ]
    },
    {
      "source": "/website%20file.html",
      "headers": [
        {
          "key": "Link",
          "value": "</assets/gift-page-overrides.css>; rel=stylesheet"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/api/website"
    },
    {
      "src": "^/website%20file\\.html$",
      "dest": "/api/website"
    },
    {
      "handle": "filesystem"
    }
  ]
}
